hievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Relate information about health and healthy habits in communicative situations.", "type": "primary"}, {"content": " Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative aspects for this level.", "type": "secondary_1"}, {"content": " Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative aspects for this level.", "type": "secondary_2"}, {"content": " Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative aspects for this level.", "type": "secondary_3"}, {"content": " Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative aspects for this level.", "type": "secondary_4"}, {"content": " Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative aspects for this level.", "type": "secondary_5"}, {"content": " Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative aspects for this level.", "type": "secondary_6"}, {"content": " Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative aspects for this level.", "type": "secondary_7"}, {"content": " Describes common health conditions by the use of the correct expressions, vocabulary and grammatical structures related to the communicative aspects for this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "  Describing Health Problems", "type": "heading"}, {"content": "A <span class=\"strong\">health problem</span> is a physical state when you do not feel well. It can cause you pain or discomfort. Sometimes a health problem can cause you not to function normally. It can make it hard for you to go to work or school, or do other things.<br /></br>You use the Present Continuous tense and the Simple Present tense to describe health problems:<br />   <span class=\"italic\">I'm not feeling well.<br /> I feel \u2026<br /> I have a \u2026<span />", "type": "describer"}, {"content": "<span class =\"strong\">Andy</span> : How are you?<br /> <span class =\"strong\">Joe</span> : I'm not feeling well. (Subject + To Be + V-ing)<br /> <span class =\"strong\">Andy</span> : What's wrong?<br /> <span class =\"strong\">Joe</span> : I have a headache. (Subject + Simple Present Tense)<br />", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " The Modals Should and Must", "type": "heading"}, {"content": "You use the modal <span class =\"strong\">should</span>  to give recommendations or advice about health problems.<br /> The modal <span class =\"strong\">must</span>   shows necessity or obligation. You use it to give very strong advice about health problems.", "type": "describer"}, {"content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Modal\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class =\\\"strong\\\">Meaning</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\">Example</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Should\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Recommendation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">  You should get some rest.   </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Must\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Necessity\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">  You must go to the doctor.   </span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "stomach ache ", "type": "name"}, {"content": "a pain in a person's stomach ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have a stomach ache.", "type": "example"}, {"content": "engenn4le03ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when you talk about being sick.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "headache ", "type": "name"}, {"content": " a pain in a person's head ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have a headache.", "type": "example"}, {"content": "engenn4le03ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sore throat ", "type": "name"}, {"content": "a pain in someone's throat ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I can't talk ... I have a sore throat.", "type": "example"}, {"content": "engenn4le03ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "runny nose ", "type": "name"}, {"content": "excess liquid from someone's nose, usually when they're sick ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have a runny nose.", "type": "example"}, {"content": "engenn4le03ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sick ", "type": "name"}, {"content": "affected by physical illness; unwell ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I feel sick. I can't go to work today.", "type": "example"}, {"content": "engenn4le03ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "contagious ", "type": "name"}, {"content": "when something can be passed from person to person through contact ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The sickness is contagious. Be careful!", "type": "example"}, {"content": "engenn4le03ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "timesheet ", "type": "name"}, {"content": "at a job, the chart with the hours a person works ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Please fill in the timesheet for next week.", "type": "example"}, {"content": "engenn4le03ob01aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": " to update ", "type": "name"}, {"content": "to give the newest information ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Please update your timesheet.", "type": "example"}, {"content": "engenn4le03ob01aud08", "type": "audio"}]}, {"content": "engenn4le03ob01re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Imagine you are an employee and your partner is your manager.", "type": "text"}, {"content": "Write a short dialogue (8-10 lines) describing some health problems you have.", "type": "text"}, {"content": "Ask for time off. Your boss gives you some strong advice.", "type": "text"}, {"content": "Practice the dialogue.", "type": "text"}, {"content": " Switch roles, and practice again.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I describe health problems in complete statements.", "type": "text"}, {"content": "I make a polite request to my boss.", "type": "text"}, {"content": "I give strong advice to an employee.", "type": "text"}]}], "type": "sena"}