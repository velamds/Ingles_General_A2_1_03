{"_data": [{"contents": [{"content": "Life on a Cruise Ship", "type": "lesson_name"}, {"content": "John Tries New Sports", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "scholar > Taking a Break > Dead Sea", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": " Present Continuous vs. Be Going To", "type": "heading"}, {"content": "You use the <span class=\"strong\">Present Continuous</span> and <span class=\"strong\">be going to</span> to talk about future actions and events.<br><br> You use the <span class=\"strong\">Present Continuous</span> to talk about arrangements and plans. <span class=\"strong\">Be going to</span> puts an emphasis on the idea of intention (decide to do something).<br>Example: <span class=\"italic\">I'm going scuba diving. vs. I'm going to go scuba diving.</span> <br><br>You can use <span class=\"strong\">intend to</span> in place of <span class=\"strong\">be going to</span>.<br> Example:<span class=\"italic\"> I intend to go scuba diving tomorrow. </span> ", "type": "describer"}], "type": "learning_points"}, {"contents": [{"content": " Extreme Sports", "type": "heading"}, {"content": "In North America, extreme sports are very popular. <br><br>Extreme sports include activities like: <br>rock climbing <Br>surfing <br>windsurfing <br>snowboarding <br>skateboarding <br>mountain biking <br>skydiving <br>hang gliding", "type": "describer"}], "type": "learning_points"}, {"contents": [{"content": "rock climbing", "type": "name"}, {"content": "the sport of climbing up large rocks and cliffs", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Why don't you try rock climbing?", "type": "example"}, {"content": "engenn4le03ob10aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use to talk about sports.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "windsurfing", "type": "name"}, {"content": "the sport of riding a board that is pushed by the wind", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm going to go windsurfing.", "type": "example"}, {"content": "engenn4le03ob10aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "water polo", "type": "name"}, {"content": "a sport in the water; you throw a ball into a net", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Why don't you try water polo?", "type": "example"}, {"content": "engenn4le03ob10aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to stay in shape", "type": "name"}, {"content": "to keep healthy and fit", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Playing soccer is a great way to stay in shape.", "type": "example"}, {"content": "engenn4le03ob10aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "license ", "type": "name"}, {"content": "an official permit to do something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have my scuba diving license.", "type": "example"}, {"content": "engenn4le03ob10aud05", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le03ob10re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Choose an extreme sport.", "type": "text"}, {"content": "Go online and research it.", "type": "text"}, {"content": "Write down 8-10 sentences about the sport.", "type": "text"}, {"content": "Tell your partner about it.", "type": "text"}, {"content": "Listen to your partner's report.", "type": "text"}, {"content": "Which sport do you want to try?", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I identify extreme sports.", "type": "text"}, {"content": "I write complete statements describing a sport.", "type": "text"}, {"content": "I discuss extreme sports with my partner and choose one to try.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn4le03ob10re2img01.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn4le03ob10re2img01.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Jasmine</span>: Hi, John. How's it going? <br>"}, {"image": "engenn4le03ob10re2img05.jpg", "time": "2500", "id": 2, "text": "<span class=\"strong\">John</span>: It's going well, thanks. Swimming with the dolphins was so fun!<br>\n<span class=\"strong\">Jasmine</span>: Yeah! I got some great pictures! <br>\n<span class=\"strong\">John</span>: I want to play soccer. It's a really popular sport in South America.<br>\n<span class=\"strong\">Jasmine</span>: Yes, I hear many people talking about it.<br>"}, {"image": "engenn4le03ob10re2img05.jpg", "time": "18000", "id": 3, "text": "<span class=\"strong\">John</span>: I can't find anyone who wants to play ...<br>\n<span class=\"strong\">Jasmine</span>: Hm, well why don't you try something else?<br>\n<span class=\"strong\">John</span>: Like what?<br>\n<span class=\"strong\">Jasmine</span>: How about rock climbing? Or water polo?<br>\n<span class=\"strong\">John</span>: Maybe ... I am thinking about windsurfing. It looks hard but fun, and a great way to stay in shape.<br>"}, {"image": "engenn4le03ob10re2img02.jpg", "time": "38000", "id": 4, "text": "<span class=\"strong\">Jasmine</span>: I'm going to go scuba diving tomorrow! I have my license.<br>\n<span class=\"strong\">John</span>: Really? I'm planning to get mine soon!<br>\n<span class=\"strong\">Jasmine</span>: Great! Then we can go together.<br>\n<span class=\"strong\">John</span>: Ok, see you later, Jasmine! Have a great time scuba diving!<br>\n<span class=\"strong\">Jasmine</span>: See ya!<br>"}], "audiosrc": "engenn4le03ob10re2aud01", "coverimg": "engenn4le03ob10re2img01.jpg"}, "type": "slideshow"}], "id": 2}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "I can talk about interests and sports.", "type": "Learning Outcomes"}, {"content": "I can talk about my plans and intentions. ", "type": "Learning Outcomes"}, {"content": "I can talk about what people are doing.", "type": "Learning Outcomes"}, {"content": "What sports do you play?", "type": "Free Header Item"}, {"content": "What new sport do you want to try? Why?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "g