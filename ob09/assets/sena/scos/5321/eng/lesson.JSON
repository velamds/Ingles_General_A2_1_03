{"_data": [{"contents": [{"content": "Life on a Cruise Ship", "type": "lesson_name"}, {"content": "New Experiences", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "scholar > Taking a Break > Florida", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_1"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_2"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_3"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_4"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_5"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_6"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_7"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "  The Present Continuous Tense", "type": "heading"}, {"content": "You use the Present Continuous tense to talk about:<ul>  \t<li>events happening now  </li> \t<li>planned events in the near future</li> </ul>   \t\t\t", "type": "describer"}, {"content": "I'm doing some homework right now.", "type": "example"}, {"content": "The form of the Present Continuous tense is: <br/><br/> Subject + to be + v-ing <br/>She is talking to John.<br/>They are going to Costa Rica.", "type": "text"}, {"content": "I'm writing that down now.", "type": "example"}, {"content": "We are going to the market tomorrow.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "knick-knack ", "type": "name"}, {"content": "a small object of little value ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We are going shopping for knick-knacks.", "type": "example"}, {"content": "engenn4le03ob09aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use to talk about a trip.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "handicrafts ", "type": "name"}, {"content": " craft; an object made by hand ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We are buying handicrafts at the market.", "type": "example"}, {"content": "engenn4le03ob09aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "traditional ", "type": "name"}, {"content": "produced or practiced for a long time ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: We are going to try traditional Costa Rican foods.", "type": "example"}, {"content": "engenn4le03ob09aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "day trip", "type": "name"}, {"content": "a trip that is short and during the day ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We are going on a day trip to the market.", "type": "example"}, {"content": "engenn4le03ob09aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " open-air ", "type": "name"}, {"content": "located outside ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: We are going to an open-air market.", "type": "example"}, {"content": "engenn4le03ob09aud05", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le03ob09re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Imagine you are on a trip. Your friends are at home.", "type": "text"}, {"content": "Write a dialogue telling them about your trip.", "type": "text"}, {"content": "Practice the dialogue with a partner.", "type": "text"}, {"content": "Switch roles and practice again.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example Dialogue\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Jill</span>: Hi, Diana! How's your trip?<br/> <span class=\\\"strong\\\">Diana</span>: Hi, Jill. It's great! I'm going to go to the beach tomorrow.<br/> <span class=\\\"strong\\\">Jill</span>: Sounds great!<br/> <span class=\\\"strong\\\">Diana</span>: Yeah, and we are going to go white-water rafting too!<br/> <span class=\\\"strong\\\">Jill</span>: I'm doing homework ... I have to go!<br/> <span class=\\\"strong\\\">Diana</span>: Talk to you later!\\\"}\"],\"styles\":\" instruction_table_background\"}", "type": "table"}], "type": "takeaway_extension"}, {"contents": [{"content": "I talk about traveling.", "type": "text"}, {"content": "I write a dialogue about a trip.", "type": "text"}, {"content": "I talk about plans and intentions.", "type": "text"}, {"content": "I practice speaking with my partner.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn4le03ob09re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn4le03ob09re2img05.jpg", "time": "10", "id": 1, "text": "<span class =\"strong\">Peter</span>: Hello?<br />\n<span class =\"strong\">John</span>: Hey, Peter! It's John!<br />\n<span class =\"strong\">Peter</span>: Hey! How's life on the cruise ship?<br /