arning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps.\nFill in the Self-Assessment."}]}], "template_override": 1}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "John: Life on a Cruise Ship"}, {"type": "unit_name", "content": "I'd Love to But ..."}, {"type": "position", "content": 6}, {"type": "origin", "content": "scholar > Taking a Break > Florida"}, {"type": "lesson", "content": 3}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": " Identifies general information in short written and spoken conversations."}, {"type": "secondary_2", "content": " Identifies general information in short written and spoken conversations."}, {"type": "secondary_3", "content": " Identifies general information in short written and spoken conversations."}, {"type": "secondary_4", "content": " Identifies general information in short written and spoken conversations."}, {"type": "secondary_5", "content": " Identifies general information in short written and spoken conversations."}, {"type": "secondary_6", "content": " Identifies general information in short written and spoken conversations."}, {"type": "secondary_7", "content": " Identifies general information in short written and spoken conversations."}, {"type": "secondary_8", "content": " Identifies general information in short written and spoken conversations."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Infinitives of Purpose "}, {"type": "describer", "content": " Infinitives are the structure <span class=\"italic\">to</span>  + <span class=\"italic\">verb</span>, like <span class =\"strong\">to go</span>  or <span class =\"strong\">to see</span>.<br /><br /> Infinitives of purpose are infinitives you place in phrases at the end of a sentence. They explain <span class=\"italic\">why</span>  the action happens."}, {"type": "example", "content": " Scientists go there <span class =\"strong\">to research</span> the flora and fauna.<br />I travel <span class =\"strong\">to meet</span> people and sightsee."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Talking About Intentions and Plans"}, {"type": "describer", "content": "You use the <span class =\"strong\">Present Continuous</span>  and <span class =\"strong\">be going to</span>  to talk about future actions and events.<br /><br />  You use the <span class =\"strong\">Present Continuous</span>  to talk about arrangements and plans. <br/><span class =\"strong\">Be going to</span>  puts an emphasis on the idea of intention (decide to do something).<br /><br /> You can use <span class =\"strong\">intend to</span>   in place of <span class =\"strong\">be going to</span>"}, {"type": "example", "content": "We are dirt biking our way to the park. vs. We are going to dirt bike our way to the park. <br /> I intend to go white-water rafting. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "trail "}, {"type": "definition", "content": "path through a forest "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The park has many trails."}, {"type": "audio", "content": "engenn4le03ob06aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about travel."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to dirt bike "}, {"type": "definition", "content": "to ride a motorcycle through forests and fields "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: We are dirt biking our way to the park."}, {"type": "audio", "content": "engenn4le03ob06aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "white-water rafting "}, {"type": "definition", "content": "the activity of riding a boat down fast water in a river "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We are going white-water rafting!"}, {"type": "audio", "content": "engenn4le03ob06aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "scientist "}, {"type": "definition", "content": "a person who studies and has knowledge of the natural world "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Scientists study the flora and fauna in the park."}, {"type": "audio", "content": "engenn4le03ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "flora "}, {"type": "definition", "content": "the plants of a particular area "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Scientists study the flora of the park."}, {"type": "audio", "content": "engenn4le03ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "fauna "}, {"type": "definition", "content": "the animals of a particular area "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Scientists study the fauna of the park."}, {"type": "audio", "content": "engenn4le03ob06aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to research "}, {"type": "definition", "content": "study; investigate "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Scientists research the flora and fauna there."}, {"type": "audio", "content": "engenn4le03ob06aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "catamaran "}, {"type": "definition", "content": "a kind of boat with a sail "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We are taking a catamaran to the dolphin cove."}, {"type": "audio", "content": "engenn4le03ob06aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cove "}, {"type": "definition", "content": "a small, sheltered area of water "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The dolphins live in the cove."}, {"type": "audio", "content": "engenn4le03ob06aud09"}]}, {"type": "background_image", "content": "engenn4le03ob06re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Imagine you are going on a trip."}, {"type": "text", "content": "Choose a place."}, {"type": "text", "content": "Create an itinerary of places to visit and things to do."}, {"type": "text", "content": "Write down the details."}, {"type": "text", "content": "Share your plans with your partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write about the purpose of actions."}, {"type": "text", "content": "I tell my partner my plans and intentions."}, {"type": "text", "content": "I write down the details of a travel itinerary."}, {"type": "text", "content": "I communicate my travel plans to my partner."}]}], "type": "sena"}