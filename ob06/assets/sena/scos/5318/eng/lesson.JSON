{"_data": [{"contents": [{"content": "Life on a Cruise Ship", "type": "lesson_name"}, {"content": "I'd Love to But ...", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "scholar > Taking a Break > Florida", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_1"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_2"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_3"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_4"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_5"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_6"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_7"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": " Infinitives of Purpose ", "type": "heading"}, {"content": " Infinitives are the structure <span class=\"italic\">to</span>  + <span class=\"italic\">verb</span>, like <span class =\"strong\">to go</span>  or <span class =\"strong\">to see</span>.<br /><br /> Infinitives of purpose are infinitives you place in phrases at the end of a sentence. They explain <span class=\"italic\">why</span>  the action happens.", "type": "describer"}, {"content": " Scientists go there <span class =\"strong\">to research</span> the flora and fauna.<br />I travel <span class =\"strong\">to meet</span> people and sightsee.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": " Talking About Intentions and Plans", "type": "heading"}, {"content": "You use the <span class =\"strong\">Present Continuous</span>  and <span class =\"strong\">be going to</span>  to talk about future actions and events.<br /><br />  You use the <span class =\"strong\">Present Continuous</span>  to talk about arrangements and plans. <br/><span class =\"strong\">Be going to</span>  puts an emphasis on the idea of intention (decide to do something).<br /><br /> You can use <span class =\"strong\">intend to</span>   in place of <span class =\"strong\">be going to</span>", "type": "describer"}, {"content": "We are dirt biking our way to the park. vs. We are going to dirt bike our way to the park.", "type": "example"}, {"content": " I intend to go white-water rafting.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "trail ", "type": "name"}, {"content": "path through a forest ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The park has many trails.", "type": "example"}, {"content": "engenn4le03ob06aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to talk about travel.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to dirt bike ", "type": "name"}, {"content": "to ride a motorcycle through forests and fields ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: We are dirt biking our way to the park.", "type": "example"}, {"content": "engenn4le03ob06aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "white-water rafting ", "type": "name"}, {"content": "the activity of riding a boat down fast water in a river ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We are going white-water rafting!", "type": "example"}, {"content": "engenn4le03ob06aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "scientist ", "type": "name"}, {"content": "a person who studies and has knowledge of the natural world ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Scientists study the flora and fauna in the park.", "type": "example"}, {"content": "engenn4le03ob06aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "flora ", "type": "name"}, {"content": "the plants of a particular area ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Scientists study the flora of the park.", "type": "example"}, {"content": "engenn4le03ob06aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "fauna ", "type": "name"}, {"content": "the animals of a particular area ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Scientists study the fauna of the park.", "type": "example"}, {"content": "engenn4le03ob06aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to research ", "type": "name"}, {"content": "study; investigate ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Scientists research the flora and fauna there.", "type": "example"}, {"content": "engenn4le03ob06aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "catamaran ", "type": "name"}, {"content": "a kind of boat with a sail ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We are taking a catamaran to the dolphin cove.", "type": "example"}, {"content": "engenn4le03ob06aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "cove ", "type": "name"}, {"content": "a small, sheltered area of water ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The dolphins live in the cove.", "type": "example"}, {"content": "engenn4le03ob06aud09", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le03ob06re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Imagine you are going on a trip.", "type": "text"}, {"content": "Choose a place.", "type": "text"}, {"content": "Create an itinerary of places to visit and things to do.", "type": "text"}, {"content": "Write down the details.", "type": "text"}, {"content": "Share your plans with your partner.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write about the purpose of actions.", "type": "text"}, {"content": "I tell my partner my plans and intentions.", "type": "text"}, {"content": "I write down the details of a travel itinerary.", "type": "text"}, {"content": "I communicate my travel plans to my partner.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"contents": [{}], "template_override": 1, "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn4le03ob06re2img01.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn4le03ob06re2img01.jpg", "time": "100", "id": 1, "text": "<span class =\"strong\">Jasmine</span>: Hey, John! What's up?"}, {"image": "engenn4le03ob06re2img05.jpg", "time": "3000", "id": 2, "text": "<span class =\"strong\">John</span>: Hey, Jasmine. I'm good. You?<br />\n<span class =\"strong\">Jasmine</span>: Great! I'm super excited about my trip to Corcovado National Park tomorrow.<br />\n<span class =\"strong\">John</span>: What's that?<br />\n<span class =\"strong\">Jasmine</span>: It's a famous park in Costa Rica. It has many animals and beautiful hiking trails.<br />\n<span class =\"strong\">John</span>: Sounds nice!"}, {"image": "engenn4le03ob06re2img02.jpg", "time":