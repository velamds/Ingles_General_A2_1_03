ntent": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0, "type": "scholar"}], "_data": [{"type": "metadata", "contents": [{"content": "Life on a Cruise Ship", "type": "lesson_name"}, {"content": "Greetings From Costa Rica", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "scholar > Out and About in the City > Mexico City", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written and spoken conversations.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "The Simple Past Tense", "type": "heading"}, {"content": "You use the Simple Past tense to talk about events that are finished.  <br><br>Remember, there are Regular and Irregular verbs.", "type": "describer"}, {"content": "We arrived two days ago.", "type": "example"}, {"content": "We went to the markets.", "type": "example"}, {"content": "My coworkers got very sick.", "type": "example"}, {"content": "I even tried some new foods!", "type": "example"}, {"content": "Simple Past tense verbs can be regular or irregular.<br/> Regular verbs end in <span class=\"italic\"> -ed</span> or <span class=\"italic\">-ied.</span> <br/> Irregular verbs change in different ways.<br/> For questions in the past, you use the auxiliary <span class=\"italic\">did</span> followed by the verb in the base form, like <span class=\"italic\">Did you ask \u2026 ?</span><br/> <span class=\"italic\">Did</span> is the past form of <span class=\"italic\">to do</span>.", "type": "text"}, {"content": "Did you have a good time?", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Present Continuous Tense", "type": "heading"}, {"content": "You use the Present Continuous tense to talk about current actions; things happening NOW.", "type": "describer"}, {"content": "I am having a great time.", "type": "example"}, {"content": "He is traveling in Cost Rica.", "type": "example"}, {"content": "You form the Present Continuous tense by using the be-verb and by adding <span class=\"italic\">-ing </span>to the base form of the verb. <br/> I AM goING <br/> She/He IS travelING <br/> They ARE buyING", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "market", "type": "name"}, {"content": "a place where products are bought and sold", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The markets are filled with food!", "type": "example"}, {"content": "engenn4le03ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about places in the city.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "crowded", "type": "name"}, {"content": "filled with many people and things", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The markets in San Jose are crowded.", "type": "example"}, {"content": "engenn4le03ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "ill ", "type": "name"}, {"content": "feeling sick or not well", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: My coworker got ill after he ate the street food.", "type": "example"}, {"content": "engenn4le03ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "street food", "type": "name"}, {"content": "food you buy and eat on the street", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The street food on Baker Street is delicious. ", "type": "example"}, {"content": "engenn4le03ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "active ", "type": "name"}, {"content": "describing a volcano that is likely to erupt", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Tomorrow we are going to visit an active volcano.", "type": "example"}, {"content": "engenn4le03ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to recognize", "type": "name"}, {"content": "to identify something or someone", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: There are foods I don't recognize.", "type": "example"}, {"content": "engenn4le03ob03aud07", "type": "audio"}]}, {"content": "engenn4le03ob03re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Write a short e-mail to your friend describing a city you visited.", "type": "text"}, {"content": "Write 6-8 sentences.", "type": "text"}, {"content": "Use the Simple Past tense.", "type": "text"}, {"content": "Read your e-mail aloud.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write an e-mail to a friend about a city.", "type": "text"}, {"content": "I write complete statements on a place I visited.", "type": "text"}, {"content": "I report about events in the past.", "type": "text"}, {"content": "I read the e-mail aloud.", "type": "text"}]}]}