{"_data": [{"contents": [{"content": "Life on a Cruise Ship", "type": "lesson_name"}, {"content": "Swimming With Dolphins", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "scholar > Taking a Break > Florida", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_1"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_2"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_3"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_4"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_5"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_6"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_7"}, {"content": " Identifies general information in short written and spoken conversations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": " Things to Take on a Trip", "type": "heading"}, {"content": "When you travel, you usually bring things that help you enjoy and remember the trip.<br />  Some examples are:<br /><br /> a waterproof camera (for trips near water)<br /> a change of clothes (for after swimming)<br /> sunglasses<br /> a hat<br /> a map<br /> a guidebook (a book that gives you information about a place or activity)<br /> a towel", "type": "describer"}, {"content": "I'm going to Mexico for a vacation. I'm going to bring my waterproof camera and my sunglasses. <br/> They're going to Peru. They're going to take a guidebook and a map.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "waterproof camera ", "type": "name"}, {"content": "a camera you can take into the water with you ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Are you taking your waterproof camera?", "type": "example"}, {"content": "engenn4le03ob07aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to talk about travel.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "experienced ", "type": "name"}, {"content": "having knowledge or skill in a particular subject ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: There's going to be an experienced guide.", "type": "example"}, {"content": "engenn4le03ob07aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "a change of clothes ", "type": "name"}, {"content": "a set of different clothes to put on after swimming ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Did you bring a change of clothes?", "type": "example"}, {"content": "engenn4le03ob07aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to kiss ", "type": "name"}, {"content": "to touch with the lips  ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Are you going to kiss the dolphins?", "type": "example"}, {"content": "engenn4le03ob07aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "at all times ", "type": "name"}, {"content": "always ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: The guide is with us at all times.", "type": "example"}, {"content": "engenn4le03ob07aud05", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le03ob07re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Talking About Plans and Intentions", "type": "heading"}, {"content": "You can use the Present Continuous and Be Going To to talk about future actions and events. ", "type": "describer"}, {"content": " You use the Present Continuous to talk about arrangements and plans. <br/> <br/>\"Be going to\" puts an emphasis on the idea of intention (decide to do something). <br/><br/>  Example: I'm going scuba diving. vs. I'm going to go scuba diving.  <br/>You can use \"intend to\" in place of \"be going to\". <br/> Example: I intend to go scuba diving tomorrow. ", "type": "text"}, {"content": "We are going to swim with dolphins tomorrow. <br/> We are swimming with dolphins at 3 p.m. ", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "With a partner, imagine you are going on a trip to a sea mammal park where you can swim with dolphins.", "type": "text"}, {"content": "Together, make a list of 5-10 things to take on your trip.", "type": "text"}, {"content": "Tell another group what you have on your list.", "type": "text"}, {"content": "Compare them  to see which items are the same and which are different.", "type": "text"}, {"content": "Discuss the differences with each other.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I talk about intentions and plans.", "type": "text"}, {"content": "I talk about things to take on a trip.", "type": "text"}, {"content": "I make a list to organize things to bring.", "type": "text"}, {"content": "I talk about similarities and differences between our lists.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn4le03ob07re2aud01", "images": [{"image": "engenn4le03ob07re2img05.jpg", "id": 0, "time": "0", "text": ""}, {"image": "engenn4le03ob07re2img05.jpg", "id": 1, "time": "100", "text": "<span class =\"strong\">Jasmine</span>: Morning, John!<br />\n<span class =\"strong\">John</span>: Morning! Are you ready to swim with dolphins?<br />\n<span class =\"strong\">Jasmine</span>: So ready! What's the plan for the day?<br />\n<span class =\"strong\">John</span>: Well, I have the pamphlet here. It says we are going to take the catamaran to the cove first.<br />\n<span class =\"strong\">Jasmine</span>: Mhm."}, {"image": "engenn4le03ob07re2img02.jpg", "id": 2, "time": "18000", "text": "<span class =\"strong\">John</span>: Then we are going to swim with six dolphins for 30 minutes.<br />\n<span class =\"strong\">Jasmine</span>: By ourselves?<br />\n<span class =\"strong\">John</span>: There's  going to be an experienced guide with us at all times.<br />\n<span class =\"strong\">Jasmine</span>: Great! Are you taking your waterproof camera?<br />\n<span class =\"strong\">John</span>: Uh, no. I don't have one!"}, {"image": "engenn4le03ob07re2img02.jpg", "id": 3, "time": "36000", "text": "<span class =\"strong\">Jasmine</span>: Don't worry, I do. <br />\n<span class =\"strong\">John</span>: Are you going to kiss the dolphins?<br />\n<span class =\"strong\">Jasmine</span>: Maybe! Are you going to ride on their backs?<br />\n<span class =\"strong\">John</span>: I hope so! Did you bring a change of clothes? <br />\n<span class =\"strong\">Jasmine</span>: Yep! What are we waiting for? Let's go!"}], "coverimg": "engenn4le03ob07re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "id": 1}, {"title": "", "contents": [{"value": {"audiosrc": "", "images": [], "coverimg": ""}, "type": "picture"}], "template_override": 1, "_data": [], "type": "audio", "id": 2}], "exercises": [{"id": 0, "stimuli_ids": [0], "template_override": 1, "_data": [{"contents": [{"content": "Vocabulary and Grammar", "type": "skill"}, {"content": "Reading", "type": "s